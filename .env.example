# Supabase Configuration
# The browser bundle can only read variables prefixed with VITE_.
# Set the VITE_ pair in Netlify; the unprefixed pair is used by Netlify Functions.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Stripe Configuration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# Gemini API
GEMINI_API_KEY=
