# Supabase Configuration
# The browser bundle can only read variables prefixed with VITE_.
# Set the VITE_ pair in Netlify; the unprefixed pair is used by Netlify Functions.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Stripe Configuration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# Gemini API
GEMINI_API_KEY=

# SMTP / Email Configuration (Monthly 22nd Subscriber Digest)
SMTP_USER=
SMTP_PASS=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_TO=keysub.kevin@gmail.com
